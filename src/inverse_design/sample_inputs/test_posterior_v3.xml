<set prefix="combined_">
    <series name="grid" start="0" end="9" ticks="10080" interval="720" radius="10" margin="2" depth="1" >
        <patch>
            <patch.parameter id="GEOMETRY" value="hex" />
        </patch>
        <agents>
            <populations>
                <population id="cancerous" init="7" class="cancer">
                    <population.parameter id="CELL_VOLUME" value="NORMAL(MU=2148.1,SIGMA=135.9)" />
                    <population.parameter id="APOPTOSIS_AGE" value="NORMAL(MU=120960,SIGMA=10080)" />
                    <population.parameter id="NECROTIC_FRACTION" value="0.785" />
                    <population.parameter id="ACCURACY" value="0.497" />
                    <population.parameter id="AFFINITY" value="0.5" />
                    <population.parameter id="COMPRESSION_TOLERANCE" value="2.271" />

                    <population.parameter id="CELL_AGE" value="UNIFORM(MIN=0,MAX=0)" />
                    <population.process id="METABOLISM" version="complex" />
                    <population.process id="SIGNALING" version="complex"  />
                    <population.parameter id="proliferation/SYNTHESIS_DURATION" value="NORMAL(MU=557,SIGMA=27)" />
                    <population.parameter id="metabolism/BASAL_ENERGY" value="NORMAL(MU=0.001505,SIGMA=0.000038)" />
                    <population.parameter id="metabolism/PROLIFERATION_ENERGY" value="NORMAL(MU=0.00097,SIGMA=0.00004)" />
                    <population.parameter id="metabolism/MIGRATION_ENERGY" value="NORMAL(MU=0.000132,SIGMA=0.000009)" />
                    <population.parameter id="metabolism/METABOLIC_PREFERENCE" value="NORMAL(MU=0.262032,SIGMA=0.020564)"/>
                    <population.parameter id="metabolism/CONVERSION_FRACTION" value="NORMAL(MU=0.118616,SIGMA=0.003134)" />
                    <population.parameter id="metabolism/RATIO_GLUCOSE_PYRUVATE" value="NORMAL(MU=0.188081,SIGMA=0.032797)" />
                    <population.parameter id="metabolism/LACTATE_RATE" value="NORMAL(MU=0.084773,SIGMA=0.003624)" />
                    <population.parameter id="metabolism/AUTOPHAGY_RATE" value="NORMAL(MU=0.000114,SIGMA=0.000006)" />
                    <population.parameter id="metabolism/GLUCOSE_UPTAKE_RATE" value="NORMAL(MU=1.350054,SIGMA=0.075105)" />
                    <population.parameter id="metabolism/ATP_PRODUCTION_RATE" value="NORMAL(MU=4.624265,SIGMA=0.495904)" />
                    <population.parameter id="signaling/MIGRATORY_THRESHOLD" value="NORMAL(MU=12.524,SIGMA=0.773)"/>
                </population>
            </populations>
        </agents>
        <environments>
            <layers>
               <layer id="GLUCOSE">
                    <layer.parameter id="INITIAL_CONCENTRATION" value="0.0083783146292677" />
                    <layer.parameter id="DIFFUSIVITY" operation="diffuser" value="39.0" />
                    <layer.parameter id="CONCENTRATION" operation="generator" value="0.0083783146292677" units="fmol/um^3" description="equal to 5 umol/cm^3" />
                    <layer.operation id="GENERATOR" />
                    <layer.operation id="DIFFUSER" />
                </layer>
                <layer id="OXYGEN">
                    <layer.parameter id="INITIAL_CONCENTRATION" value="26.770494968916783" />
                    <layer.parameter id="DIFFUSIVITY" operation="diffuser" value="2000.0" />
                    <layer.parameter id="CONCENTRATION" operation="generator" value="26.770494968916783" units="mmHg" />
                    <layer.operation id="DIFFUSER" />
                    <layer.operation id="GENERATOR" />
                </layer>
                <layer id="TGFA">
                    <layer.parameter id="INITIAL_CONCENTRATION" value="150" />
                    <layer.parameter id="DIFFUSIVITY" operation="diffuser" value="51.8" />
                    <layer.operation id="DIFFUSER" />
                </layer>
            </layers>
            <components>
                <component id="SITES" class="source_sites">
                    <component.register id="GLUCOSE" />
                    <component.register id="OXYGEN" />
                    <component.parameter id="X_SPACING" value="*:8" />
                    <component.parameter id="Y_SPACING" value="*:9" />
                </component>
            </components>
        </environments>
    </series>
</set>
